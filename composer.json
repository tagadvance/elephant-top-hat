{
    "name": "tagadvance/elephant-top-hat",
    "description": "A tiny stand-alone library for parsing the output of the Linux top command.",
    "type": "library",
    "keywords": [
        "linux",
        "top",
        "procps",
        "process",
        "monitoring"
    ],
    "homepage": "https://github.com/tagadvance/elephant-top-hat",
    "license": "MIT",
    "authors": [
        {
            "name": "Tag",
            "email": "tagadvance+github.com@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tagadvance/elephant-top-hat/issues"
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*"
    },
    "autoload" : {
        "psr-4" : {
            "tagadvance\\" : "src/tagadvance/"
        }
    },
    "require-dev": {
        "ext-dom": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    }
}
